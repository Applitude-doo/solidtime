# Read by docker compose (variable interpolation). Copy to .env and fill in.

# Pin to a release from https://github.com/solidtime-io/solidtime/releases — upgrade deliberately.
SOLIDTIME_IMAGE_TAG=0.21.0

APP_DOMAIN=time.applitude.tech
REVERSE_PROXY_NETWORK=reverse-proxy

DB_DATABASE=solidtime
DB_USERNAME=solidtime
# Generate with: openssl rand -hex 32
DB_PASSWORD=

# Optional services: "pdf" starts Gotenberg (PDF exports, needs ~500 MB RAM)
# COMPOSE_PROFILES=pdf
