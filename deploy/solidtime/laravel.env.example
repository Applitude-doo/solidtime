# Read by the solidtime containers. Copy to laravel.env and fill in.
# DB_* settings are injected from .env by docker-compose.yml — do not set them here.

# Application
APP_NAME=solidtime
VITE_APP_NAME=solidtime
APP_ENV=production
APP_DEBUG=false
APP_URL=https://time.applitude.tech
APP_FORCE_HTTPS=true
# on | invite-only | off — internal tool: new users join via invitation
APP_ENABLE_REGISTRATION=invite-only
# Comma-separated emails with access to the /admin panel
SUPER_ADMINS=marko@applitude.tech
# Subnet of the reverse-proxy network (fixed at creation, see README)
TRUSTED_PROXIES=172.30.0.0/24

# Keys — generate with: docker compose run --rm scheduler php artisan self-host:generate-keys
APP_KEY=
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# Logging
LOG_CHANNEL=stderr_daily
LOG_LEVEL=info

# Queue / storage
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
PUBLIC_FILESYSTEM_DISK=public

# Mail (external SMTP — Hetzner blocks outbound 25/465 on new accounts)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@applitude.tech
MAIL_FROM_NAME=solidtime

# PDF exports
# Uncomment together with COMPOSE_PROFILES=pdf in .env
# GOTENBERG_URL=http://gotenberg:3000
